generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  CUSTOMER
  WORKER
  ADMIN
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum BookingStatus {
  PENDING
  ACCEPTED
  WORKER_ASSIGNED
  DISPATCH_FAILED
  EN_ROUTE
  ARRIVED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  CANCELLED_MANUAL
  CANCELLED_NO_SHOW
  REFUNDED
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
  SUSPENDED
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
}

enum CouponType {
  PERCENTAGE
  FIXED
}

enum PriceRuleType {
  BASE
  CITY
  SEASONAL
  PROMOTIONAL
  SURGE
  WORKER
}

enum CatalogImportStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum MaintenancePlanStatus {
  ACTIVE
  PAUSED
  CANCELLED
}

enum MaintenanceOccurrenceStatus {
  AWAITING_CONFIRMATION
  BOOKING_CREATED
  SKIPPED
  FAILED
  CANCELLED
}

model City {
  id            String   @id @default(cuid())
  name          String   @unique
  state         String
  district      String?
  stateId       String
  stateRecord   GeoState @relation(fields: [stateId], references: [id], onDelete: Restrict)
  districtId    String?
  districtRecord GeoDistrict? @relation(fields: [districtId, stateId], references: [id, stateId], onDelete: Restrict)
  country       String   @default("India")
  slug          String   @unique
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  users         User[]
  workers       WorkerProfile[]
  serviceAreas  ServiceArea[]
  addresses     Address[]
  bookings      Booking[]
  servicePriceRules ServicePriceRule[]
  commissions   Commissions[]

  @@index([stateId, districtId, isActive])
}

model GeoState {
  id        String        @id @default(cuid())
  name      String        @unique
  isActive  Boolean       @default(true)
  cities    City[]
  districts GeoDistrict[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model GeoDistrict {
  id        String   @id @default(cuid())
  stateId   String
  state     GeoState @relation(fields: [stateId], references: [id], onDelete: Restrict)
  name      String
  cities    City[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([stateId, name])
  @@unique([id, stateId])
  @@index([stateId, name])
}

model GeoPincode {
  id               String                 @id @default(cuid())
  code             String                 @unique @db.VarChar(6)
  areaAssignments  ServiceAreaPincode[]
  createdAt        DateTime               @default(now())

  @@index([code])
  @@unique([id, code])
}

model User {
  id               String   @id @default(cuid())
  role             UserRole @default(CUSTOMER)
  name             String
  email            String?  @unique
  phone            String?  @unique
  passwordHash     String?
  avatarUrl        String?
  walletBalance    Decimal  @default(0.0) @db.Decimal(12, 2)
  referralRewardsIssued Int @default(0)
  emailVerifiedAt  DateTime?
  phoneVerifiedAt   DateTime?
  isActive         Boolean  @default(true)
  marketingNotificationsEnabled Boolean @default(false)
  referralCode     String?  @unique
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  cityId           String?
  city             City?    @relation(fields: [cityId], references: [id])
  addresses        Address[]
  savedAddresses   SavedAddress[]
  bookings         Booking[] @relation("CustomerBookings")
  reviewsWritten   Review[]  @relation("ReviewerReviews")
  reviewReports    ReviewReport[]
  notifications    Notification[]
  deviceTokens     DeviceToken[]
  refreshTokens    RefreshToken[]
  workerProfile    WorkerProfile?
  authSessions     AuthSession[]
  catalogImportJobs CatalogImportJob[]
  walletTransactions WalletTransaction[]
  supportTickets   SupportTicket[]
  supportTicketsAssigned SupportTicket[] @relation("SupportTicketAssignee")
  supportTicketReplies SupportTicketReply[]
  documents        Document[]
  referralsMade    Referral[] @relation("Referrer")
  referredBy       Referral?  @relation("ReferredUser")
  uploadedDiagnosticPhotos BookingDiagnosticPhoto[] @relation("BookingDiagnosticPhotoUploader")
  maintenancePlans MaintenancePlan[]
}

model DeviceToken {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token      String   @unique
  platform   String?
  deviceId   String?
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId, lastSeenAt])
}

model WorkerProfile {
  id                  String             @id @default(cuid())
  userId              String             @unique
  user                User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  onboardingStatus    String             @default("pending_documents")
  fullName            String?
  gender              Gender?
  dateOfBirth         DateTime?
  addressLine1        String?
  alternatePhone      String?
  city                String?
  pincode             String?
  serviceAreas        String?            @db.VarChar(500)
  workType            String             @default("FULL_TIME")
  acceptsUrgentJobs   Boolean            @default(true)
  aadhaarNumber       String?
  aadhaarDocUrl       String?
  aadhaarDocPublicId  String?
  bankAccountNumber   String?
  bankIfsc            String?
  upiId               String?
  toolsOwned          String[]           @default([])
  emergencyContactName  String?
  emergencyContactPhone  String?
  agreementAcceptedAt DateTime?
  dataConsentAcceptedAt DateTime?
  rejectionReason     String?
  reviewedBy          String?
  reviewedAt          DateTime?
  submittedAt         DateTime?
  cityId              String?
  cityRelation        City?              @relation(fields: [cityId], references: [id])
  latitude            Decimal?           @db.Decimal(10, 7)
  longitude           Decimal?           @db.Decimal(10, 7)
  displayName         String?
  bio                 String?
  experienceYears     Int                @default(0)
  serviceRadiusKm     Int                @default(10)
  basePrice           Decimal            @default(0.0) @db.Decimal(12, 2)
  commissionRate      Decimal            @default(0.0) @db.Decimal(5, 2)
  averageRating       Decimal            @default(0.0) @db.Decimal(3, 2)
  completedJobsCount  Int                @default(0)
  noShowCount         Int                @default(0)
  verificationStatus  VerificationStatus @default(PENDING)
  isAvailable         Boolean            @default(false)
  isOnline            Boolean            @default(false)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  skills              WorkerSkill[]
  documents           WorkerDocument[]
  portfolioPhotos     WorkerPortfolioPhoto[]
  bookings            Booking[]          @relation("AssignedWorkerBookings")
  reviews             Review[]
  workingHours        WorkingHour[]
  holidays            Holiday[]
  workerServices      WorkerService[]
  earnings            WalletTransaction[]
  profileDocuments    Document[]
  availability        WorkerAvailability[]
  payoutChangeRequests WorkerPayoutChangeRequest[]
  serviceAreaAssignments WorkerProfileServiceArea[]

  @@index([onboardingStatus, verificationStatus])
}

model WorkerPayoutChangeRequest {
  id                String        @id @default(cuid())
  workerProfileId   String
  workerProfile     WorkerProfile @relation(fields: [workerProfileId], references: [id], onDelete: Cascade)
  pendingKey        String?       @unique
  bankAccountNumber String?
  bankIfsc          String?
  upiId             String?
  status            String        @default("pending")
  rejectionReason   String?
  reviewedBy        String?
  reviewedAt        DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([status, createdAt])
  @@index([workerProfileId, createdAt])
}

model WalletTransaction {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  workerId      String?
  worker        WorkerProfile? @relation(fields: [workerId], references: [id], onDelete: Cascade)
  type          String
  amount        Decimal  @db.Decimal(12, 2)
  referenceType String?
  referenceId   String?
  balanceAfter  Decimal  @db.Decimal(12, 2)
  metadata      Json?
  createdAt     DateTime @default(now())

  @@index([userId, createdAt])
  @@index([workerId, createdAt])
}

model ServiceCategory {
  id              String                     @id @default(cuid())
  name            String                     @unique
  slug            String                     @unique
  description     String?
  iconUrl         String?
  seoTitle        String?
  seoDescription  String?
  sortOrder       Int                        @default(0)
  isActive        Boolean                    @default(true)
  featured        Boolean                    @default(false)
  popular         Boolean                    @default(false)
  availabilityMode String                    @default("INHERITED")
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt
  services        Service[]
  subcategories   ServiceSubcategory[]
  workerSkills    WorkerSkill[]
  translations    ServiceCategoryTranslation[]
  serviceAreaAssignments ServiceAreaCategory[]

  @@index([availabilityMode, isActive])
}

model ServiceSubcategory {
  id              String                     @id @default(cuid())
  categoryId      String
  category        ServiceCategory            @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name            String
  slug            String                     @unique
  description     String?
  iconUrl         String?
  seoTitle        String?
  seoDescription  String?
  basePrice       Decimal                    @default(0.0) @db.Decimal(12, 2)
  sortOrder       Int                        @default(0)
  rating          Decimal                    @default(0.0) @db.Decimal(3, 2)
  reviewCount     Int                        @default(0)
  isActive        Boolean                    @default(true)
  availabilityMode String                   @default("INHERITED")
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt
  bookingServices BookingService[]
  catalogServices Service[]
  translations    ServiceSubcategoryTranslation[]
  serviceAreaAssignments ServiceAreaSubcategory[]

  @@index([categoryId, availabilityMode])
}

model Service {
  id                    String                @id @default(cuid())
  categoryId            String
  category              ServiceCategory       @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  subcategoryId         String
  subcategory           ServiceSubcategory    @relation(fields: [subcategoryId], references: [id], onDelete: Cascade)
  name                  String
  slug                  String                @unique
  code                  String                @unique
  description           String?
  shortDescription      String?
  startingPrice         Decimal               @db.Decimal(12, 2)
  gstRate               Decimal               @default(18.00) @db.Decimal(5, 2)
  sacCode               String?
  estimatedDurationMins  Int
  warrantyDays          Int                   @default(0)
  gstApplicable         Boolean               @default(true)
  emergencyAvailable    Boolean               @default(false)
  homeVisit             Boolean               @default(true)
  requiresSiteVisit     Boolean               @default(false)
  bookingEnabled        Boolean               @default(true)
  priceType             String                @default("FROM")
  ctaLabel              String                @default("Book service")
  warrantyText          String?
  guaranteeEnabled      Boolean               @default(false)
  guaranteeClaimWindowDays Int                 @default(0)
  guaranteeIssueCategories String[]             @default([])
  guaranteeTerms        String?
  guaranteeExclusions   String?
  guaranteeResolutionTypes String[]            @default([])
  guaranteeRequiresPartnerReview Boolean        @default(false)
  guaranteeEvidenceRequired Boolean             @default(false)
  requirements          String[]              @default([])
  isActive              Boolean               @default(true)
  publicationStatus     String                @default("PUBLISHED")
  availabilityMode      String                @default("INHERITED")
  maintenanceEnabled    Boolean               @default(false)
  maintenanceIntervalsMonths Int[]            @default([])
  maintenanceReminderHours Int                 @default(24)
  publishStartsAt       DateTime?
  publishEndsAt         DateTime?
  featured              Boolean               @default(false)
  popular               Boolean               @default(false)
  rating                Decimal               @default(0.0) @db.Decimal(3, 2)
  reviewCount           Int                   @default(0)
  cancellationPolicy    String?
  inclusions            String[]
  exclusions            String[]
  seoTitle              String?
  seoDescription        String?
  seoKeywords           String?
  iconUrl               String?
  sortOrder             Int                   @default(0)
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  translations          ServiceTranslation[]
  images                ServiceImage[]
  requiredSkills        ServiceRequiredSkill[]
  requiredTools         ServiceRequiredTool[]
  requiredDocuments     ServiceRequiredDocument[]
  pricingRules          ServicePriceRule[]
  workerServices        WorkerService[]
  bookingServices       BookingService[]
  disputes              Dispute[]
  searchKeywords        ServiceSearchKeyword[]
  homeSectionItems      HomeServiceSectionItem[]
  variants              ServiceVariant[]
  addons                ServiceAddon[]
  serviceAreaAssignments ServiceAreaService[]
  maintenancePlans      MaintenancePlan[]

  @@index([availabilityMode, isActive])
}

model ServiceVariant {
  id                    String   @id @default(cuid())
  serviceId             String
  service               Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  name                  String   @db.VarChar(120)
  description           String?  @db.VarChar(1000)
  imageUrl              String?  @db.VarChar(2048)
  price                 Decimal  @db.Decimal(12, 2)
  originalPrice         Decimal? @db.Decimal(12, 2)
  estimatedDurationMins Int?
  isAvailable           Boolean  @default(true)
  availabilityMode      String   @default("INHERITED")
  sortOrder             Int      @default(0)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  serviceAreaAssignments ServiceAreaVariant[]
  maintenancePlans MaintenancePlan[]

  @@index([serviceId, isAvailable, sortOrder])
  @@index([serviceId, availabilityMode])
}

model ServiceAddon {
  id                    String   @id @default(cuid())
  serviceId             String
  service               Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  name                  String   @db.VarChar(120)
  description           String?  @db.VarChar(1000)
  imageUrl              String?  @db.VarChar(2048)
  price                 Decimal  @db.Decimal(12, 2)
  estimatedDurationMins Int?
  isActive              Boolean  @default(true)
  sortOrder             Int      @default(0)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([serviceId, isActive, sortOrder])
}

model ServiceArea {
  id                String   @id @default(cuid())
  cityId            String
  city              City     @relation(fields: [cityId], references: [id])
  name              String
  slug              String
  pincode           String?
  pincodeRangeStart String?
  pincodeRangeEnd   String?
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  serviceAssignments ServiceAreaService[]
  assignedPincodes  ServiceAreaPincode[]
  categoryAssignments ServiceAreaCategory[]
  subcategoryAssignments ServiceAreaSubcategory[]
  variantAssignments ServiceAreaVariant[]
  workerAssignments WorkerProfileServiceArea[]

  @@unique([cityId, slug])
  @@index([cityId, isActive])
}

model ServiceAreaPincode {
  id            String      @id @default(cuid())
  serviceAreaId String
  serviceArea   ServiceArea @relation(fields: [serviceAreaId], references: [id], onDelete: Cascade)
  pincode       String      @db.VarChar(6)
  pincodeId     String
  pincodeRecord GeoPincode  @relation(fields: [pincodeId, pincode], references: [id, code], onDelete: Restrict)
  createdAt     DateTime    @default(now())

  @@unique([serviceAreaId, pincode])
  @@index([pincode])
  @@index([pincodeId])
}

model ServiceAreaService {
  serviceId    String
  service      Service     @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  serviceAreaId String
  serviceArea  ServiceArea @relation(fields: [serviceAreaId], references: [id], onDelete: Cascade)
  createdAt    DateTime    @default(now())

  @@id([serviceId, serviceAreaId])
  @@index([serviceAreaId, serviceId])
}

model ServiceAreaCategory {
  categoryId   String
  category     ServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  serviceAreaId String
  serviceArea  ServiceArea @relation(fields: [serviceAreaId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())

  @@id([categoryId, serviceAreaId])
  @@index([serviceAreaId, categoryId])
}

model ServiceAreaSubcategory {
  subcategoryId String
  subcategory   ServiceSubcategory @relation(fields: [subcategoryId], references: [id], onDelete: Cascade)
  serviceAreaId String
  serviceArea   ServiceArea @relation(fields: [serviceAreaId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())

  @@id([subcategoryId, serviceAreaId])
  @@index([serviceAreaId, subcategoryId])
}

model ServiceAreaVariant {
  variantId    String
  variant      ServiceVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  serviceAreaId String
  serviceArea  ServiceArea @relation(fields: [serviceAreaId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())

  @@id([variantId, serviceAreaId])
  @@index([serviceAreaId, variantId])
}

model WorkerProfileServiceArea {
  workerProfileId String
  workerProfile   WorkerProfile @relation(fields: [workerProfileId], references: [id], onDelete: Cascade)
  serviceAreaId   String
  serviceArea     ServiceArea @relation(fields: [serviceAreaId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())

  @@id([workerProfileId, serviceAreaId])
  @@index([serviceAreaId, workerProfileId])
}

model Address {
  id            String   @id @default(cuid())
  userId        String
  cityId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  city          City     @relation(fields: [cityId], references: [id])
  label         String
  line1         String
  line2         String?
  landmark      String?
  pincode       String
  latitude      Decimal? @db.Decimal(10, 7)
  longitude     Decimal? @db.Decimal(10, 7)
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  bookings      Booking[]
  maintenancePlans MaintenancePlan[]
}

model SavedAddress {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label        String
  addressLine1 String
  addressLine2 String?
  landmark     String?
  city         String
  pincode      String
  lat          Float
  lng          Float
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId, isDefault, createdAt])
}

model Booking {
  id              String         @id @default(cuid())
  code            String         @unique
  clientRequestKey  String?        @db.VarChar(120)
  clientRequestHash String?       @db.VarChar(64)
  customerId      String
  customer        User           @relation("CustomerBookings", fields: [customerId], references: [id], onDelete: Cascade)
  workerId        String?
  worker          WorkerProfile? @relation("AssignedWorkerBookings", fields: [workerId], references: [id], onDelete: SetNull)
  bookingType     String         @default("instant")
  scheduledFor    DateTime?
  cityId          String
  city            City           @relation(fields: [cityId], references: [id])
  addressId       String
  address         Address        @relation(fields: [addressId], references: [id])
  status          BookingStatus   @default(PENDING)
  scheduledAt     DateTime
  notes           String?
  customerNotes   String?
  completionOtp   String?
  subtotalAmount  Decimal        @db.Decimal(12, 2)
  discountAmount  Decimal        @default(0.0) @db.Decimal(12, 2)
  taxAmount       Decimal        @default(0.0) @db.Decimal(12, 2)
  totalAmount     Decimal        @db.Decimal(12, 2)
  customQuoteAmount Decimal?     @db.Decimal(12, 2)
  customQuoteItemized Json?
  customQuoteNotes    String?
  customQuoteStatus   String?
  customQuoteRevision Int @default(0)
  customQuoteRevisions CustomQuoteRevision[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  services        BookingService[]
  invoice         Invoice?
  payments        Payment[]
  reviews         Review[]
  timeline        BookingTimelineEvent[]
  jobExecution    JobExecution?
  payout          Payout?
  disputes        Dispute[]
  dispatchOffers  DispatchOffer[]
  refunds         Refund[]
  chatRoom        ChatRoom?
  sparePartRequest SparePartRequest?
  diagnosticPhotos BookingDiagnosticPhoto[]
  maintenanceOccurrence MaintenanceOccurrence?

  @@index([customerId, status])
  @@index([workerId, status])
  @@index([cityId, status])
  @@index([status])
  @@index([scheduledFor])
  @@index([customerId])
  @@index([workerId])
  @@unique([customerId, clientRequestKey])
}

model MaintenancePlan {
  id                    String   @id @default(cuid())
  customerId            String
  customer              User     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  serviceId             String
  service               Service  @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  variantId             String?
  variant               ServiceVariant? @relation(fields: [variantId], references: [id], onDelete: Restrict)
  addressId             String
  address               Address  @relation(fields: [addressId], references: [id], onDelete: Restrict)
  intervalMonths        Int
  preferredTime         String?  @db.VarChar(5)
  timezone              String   @default("Asia/Kolkata")
  startAt               DateTime @db.Date
  endAt                 DateTime? @db.Date
  nextDueAt             DateTime @db.Date
  nextSequence          Int      @default(1)
  status                MaintenancePlanStatus @default(ACTIVE)
  confirmationRequired Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  occurrences           MaintenanceOccurrence[]
  events                MaintenancePlanEvent[]

  @@index([status, nextDueAt])
  @@index([customerId, status, createdAt])
  @@index([serviceId, status])
  @@index([variantId])
}

model MaintenanceOccurrence {
  id             String   @id @default(cuid())
  planId         String
  plan           MaintenancePlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  sequence       Int
  dueAt          DateTime @db.Date
  status         MaintenanceOccurrenceStatus @default(AWAITING_CONFIRMATION)
  bookingId      String?  @unique
  booking        Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  reminderSentAt DateTime?
  attemptCount   Int      @default(0)
  failureReason  String?  @db.VarChar(500)
  respondedAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([planId, sequence])
  @@index([status, dueAt])
  @@index([planId, dueAt])
}

model MaintenancePlanEvent {
  id         String   @id @default(cuid())
  planId     String
  plan       MaintenancePlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  actorId    String?
  action     String   @db.VarChar(40)
  details    Json?
  createdAt  DateTime @default(now())

  @@index([planId, createdAt])
}

model WorkerAvailability {
  id         String        @id @default(cuid())
  workerId   String
  worker     WorkerProfile @relation(fields: [workerId], references: [id], onDelete: Cascade)
  dayOfWeek  Int
  startTime  String
  endTime    String
  createdAt  DateTime      @default(now())

  @@index([workerId, dayOfWeek])
}

model Payout {
  id               String   @id @default(cuid())
  bookingId        String   @unique
  booking          Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  workerId         String
  amount           Float
  commissionAmount Float
  status           String   @default("pending")
  razorpayPayoutId String?
  providerAttemptId String?
  failureReason    String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([status, createdAt])
  @@index([status])
  @@index([workerId])
}

model JobExecution {
  id                 String    @id @default(cuid())
  bookingId          String    @unique
  booking            Booking   @relation(fields: [bookingId], references: [id])
  otpStart           String?
  otpStartExpiresAt   DateTime?
  otpStartVerifiedAt  DateTime?
  otpEnd             String?
  otpEndExpiresAt    DateTime?
  otpEndVerifiedAt   DateTime?
  status             String    @default("assigned")
  arrivedAt          DateTime?
  startedAt          DateTime?
  completedAt        DateTime?
  beforePhotos       String[]
  afterPhotos        String[]
  checklist          Json?
  workerLat         Float?
  workerLng         Float?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([status])
}

model Dispute {
  id             String    @id @default(cuid())
  bookingId      String
  booking        Booking   @relation(fields: [bookingId], references: [id])
  raisedBy       String
  reason         String
  status         String    @default("open")
  resolutionNote String?
  resolvedBy     String?
  resolvedAt     DateTime?
  refundId       String?   @unique
  refund         Refund?   @relation("DisputeRefund", fields: [refundId], references: [id], onDelete: SetNull)
  issueCategory  String?   @db.VarChar(60)
  serviceId      String?
  service        Service?  @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  referenceCode  String?  @unique @db.VarChar(32)
